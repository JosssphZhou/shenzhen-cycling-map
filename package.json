{
  "name": "shenzhen-cycling-map",
  "version": "1.0.0",
  "private": true,
  "description": "基于真实地理的深圳骑行地图，面向公路车骑前选线",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3701",
    "build": "next build",
    "start": "node scripts/serve-static.mjs",
    "postbuild": "node scripts/compress-static.mjs",
    "typecheck": "tsc --noEmit",
    "check:data": "node scripts/check-data.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.8",
    "@types/node": "^22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "^5"
  }
}
